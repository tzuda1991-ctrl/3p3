<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <ImageView android:id="@+id/coin" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/highScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/hist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <Button android:id="@+id/heads" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="heads" />
    <Button android:id="@+id/tails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tails" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

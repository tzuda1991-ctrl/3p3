<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <Button android:id="@+id/btnAllin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnAllin" />
    <Button android:id="@+id/btnHalfpot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnHalfpot" />
    <Button android:id="@+id/btnFullPot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnFullPot" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

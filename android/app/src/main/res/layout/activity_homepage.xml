<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlt_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg">

    <RelativeLayout
        android:id="@+id/rlt_animation_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55060B17">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#CC0F172A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <!-- Profile -->
            <RelativeLayout
                android:id="@+id/rltimageptofile"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/imaprofile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/app_icon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/imaprofile"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Player"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/txt_user_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID: 1" android:textColor="#94A3B8" android:textSize="10sp" />
                        <TextView android:id="@+id/tvUserCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="VIP" android:textColor="#FBBF24" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Wallet Chip Pill -->
            <LinearLayout
                android:id="@+id/lnrbuychips"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/background_border"
                android:gravity="center_vertical"
                android:onClick="openBuyChipsActivity"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="6dp">

                <TextView
                    android:id="@+id/txtwallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 1000"
                    android:textColor="#FBBF24"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/iv_add"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/gold_add_btn" />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Action buttons -->
            <LinearLayout android:id="@+id/lnr_redeem" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/d_orange_corner" android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Withdraw" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lnr_statement" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/tvGameRecord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lnrinvite" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refer" android:textColor="#FBBF24" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lnrmail" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/txtMail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mail" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/lnrsetting" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_marginEnd="6dp">
                <ImageView android:id="@+id/imgsetting" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/d_pop_setting" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgLogout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/btn_logout" />
        </LinearLayout>

        <!-- CATEGORY TABS -->
        <LinearLayout
            android:id="@+id/lnrGamesTabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/topBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <LinearLayout android:id="@+id/lnr_all" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/btn_all" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/d_orange_corner" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="ALL GAMES" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lnr_multiplayer" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/btn_multiplayer" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="MULTIPLAYER" android:textColor="#E2E8F0" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lnr_skills" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/btn_skills" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="SKILLS" android:textColor="#E2E8F0" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lnr_slots" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/btn_slots" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="SLOTS" android:textColor="#E2E8F0" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lnr_sports" android:layout_width="wrap_content" android:layout_height="32dp">
                <TextView android:id="@+id/btn_sports" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/d_toolbar_bg" android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="SPORTS" android:textColor="#E2E8F0" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- MAIN GAME LOBBY AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/lnrGamesTabs"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Left Mascot + Spin -->
            <LinearLayout
                android:layout_width="115dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="104dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/lnr_spin_win"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/homespin"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>

            <!-- Games RecyclerView -->
            <FrameLayout
                android:id="@+id/home_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recGamesList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- Hidden Legacy Views Required by Homepage.java -->
        <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
            <TextView android:id="@+id/txtproname" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltDragonTiger" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltTeenpatti" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltPrivate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltAndharbhar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltRummy" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltJackpot" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltRummyDeal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltRummyPool" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltSeveUp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltCarRoullete" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RelativeLayout android:id="@+id/rltAnimalRoullete" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.gigamole.infinitecycleviewpager.HorizontalInfiniteCycleViewPager android:id="@+id/view_pager" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <cn.trinea.android.view.autoscrollviewpager.AutoScrollViewPager android:id="@+id/pager" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <androidx.viewpager.widget.ViewPager android:id="@+id/viewpager" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.viewpagerindicator.CirclePageIndicator android:id="@+id/titles" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/imgpublicGame" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/imgPrivategame" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/ImgCustomePage" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/ImgVariationGane" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/iv_andher" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_first_reacharge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_spinner" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_mail" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnrhistory" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_private" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_2player" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/lnr_5player" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tv_2player" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tv_5player" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/edit_searchview" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <EditText android:id="@+id/et_code" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btn_join_private" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btn_play" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/img_close" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/imgclosetop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/imgCreatetable" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/imgicon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/image" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <SeekBar android:id="@+id/seekBar1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtBootamount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtheader" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtLimit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtMaximumbetvalue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtNumberofBlind" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtPotLimit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtStart" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtwalletchips" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <View android:id="@+id/view_center" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>

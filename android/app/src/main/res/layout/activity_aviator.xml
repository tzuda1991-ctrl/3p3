<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <ImageView android:id="@+id/gif_roket" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txt_inner_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <ImageView android:id="@+id/img_start_game" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/txt_amount" android:layout_width="match_parent" android:layout_height="44dp" android:hint="txt_amount" android:textColor="#FFFFFF" android:textColorHint="#94A3B8" android:background="#1E293B" android:padding="8dp" android:layout_marginBottom="6dp" />
    <TextView android:id="@+id/txt_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_exit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_exit_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <LinearLayout android:id="@+id/lnr_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btn_start" />
    <TextView android:id="@+id/txt_wallet_amt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_username" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

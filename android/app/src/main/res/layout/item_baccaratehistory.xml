<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <ImageView android:id="@+id/ivUserImage" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/ivJackpotCard1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/ivJackpotCard2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/ivJackpotCard3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txtheader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recJackpotHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/imgclosetop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/tvWinnerId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/tvrewards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txtName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/tvbetvalue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <TextView android:id="@+id/txt_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_entry_fee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_join" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_no_participants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_start_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txtheader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <ImageView android:id="@+id/imgclosetop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/lnrlastView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <ImageView android:id="@+id/imaprofile" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txtproname" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txtwallet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <View android:id="@+id/lnrhistory" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <View android:id="@+id/lnrhome" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/imghistory" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/imggame" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txthistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txtgame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <FrameLayout android:id="@+id/home_container" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_border"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify OTP (Use: 1234)"
            android:textColor="#FBBF24"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgclose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/close" />
    </RelativeLayout>

    <EditText
        android:id="@+id/edit_OTP"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_box"
        android:hint="Enter OTP (1234)"
        android:inputType="number"
        android:paddingLeft="14dp"
        android:text="1234"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/edit_phone_edit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_edit_box"
        android:hint="Mobile Number"
        android:paddingLeft="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_edit_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Mobile"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imglogin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/btn_green_bg"
        android:padding="10dp"
        android:src="@drawable/correct"
        android:scaleType="centerInside" />
</LinearLayout>

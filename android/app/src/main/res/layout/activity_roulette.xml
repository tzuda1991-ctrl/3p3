<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <Button android:id="@+id/spinBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="spinBtn" />
    <TextView android:id="@+id/resultTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <ImageView android:id="@+id/wheel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txt_cat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <LinearLayout android:id="@+id/lnrfollow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <RelativeLayout android:id="@+id/relativeChip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.cardview.widget.CardView android:id="@+id/cardView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/lnr_firstRow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/lnr_secondRow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

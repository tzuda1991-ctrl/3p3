<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <View android:id="@+id/imgclosetop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/lnr_language" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tv_language" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/tv_playerid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/tv_playername" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <ImageView android:id="@+id/imaprofile" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txtheader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txt_sound" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnPrivacy" />
    <Button android:id="@+id/btnHowtoplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnHowtoplay" />
    <Button android:id="@+id/btnTermscond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnTermscond" />
    <Button android:id="@+id/btnHelpandsupport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btnHelpandsupport" />
    <LinearLayout android:id="@+id/lnrlogoutdia" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
    <TextView android:id="@+id/tvDeal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/txtheader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <ImageView android:id="@+id/imgclosetop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/lnrSelectTable" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvSelectBoot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btn_play" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="btn_play" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
